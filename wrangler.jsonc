// Réglages Cloudflare (hébergement de callitcards.com, choisi le 27/11/2026).
// Le Worker (cloudflare/worker.js) sert :
//   - les pages des cartes (fr, en, de, es, it) et les images (img/) depuis R2,
//     parce qu'elles dépassent la limite de 100 000 fichiers d'un site Cloudflare ;
//   - tout le reste (l'appli) depuis les fichiers du dépôt (« assets »).
// Mise en ligne : .github/workflows/cloudflare.yml
{
  "name": "callit",
  "account_id": "49e9d03173cee583d4128f2f3021fcd9",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/a/*", "/img/*", "/fr/*", "/en/*", "/de/*", "/es/*", "/it/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "callit-site" }
  ],
  // Liens courts des analyses (cloudflare/analyse.js) : au plus 20 envois par minute et par adresse
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  // Chaque heure : efface les analyses partagées de plus de 48 h
  "triggers": { "crons": ["23 * * * *"] },
  "observability": { "enabled": true }
}
